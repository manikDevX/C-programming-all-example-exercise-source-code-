#include<stdio.h>
int main()
{
    float seconds,minutes,hours,days;

    printf("Enter the value of seconds: ");
    scanf("%f",&seconds);

    minutes=seconds/60;
    hours=minutes/60;
    days=hours/24;

    printf("Time in minutes is %.3f\n",minutes);
    printf("Time in hours is %.3f\n",hours);
    printf("Time in days is %.3f",days);

    return 0;
}
