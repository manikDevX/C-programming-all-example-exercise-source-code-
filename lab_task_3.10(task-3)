#include<stdio.h>
int main()
{
   int a,b;

   printf("Enter the value of a: ");
   scanf("%d",&a);

   printf("Enter the value of b: ");
   scanf("%d",&b);

   printf("a<b=%d\n",a<b);
   printf("a<=b=%d\n",a<=b);
   printf("a>b=%d\n",a>b);
   printf("a>=b=%d\n",a>=b);
   printf("a==b=%d\n",a==b);
   printf("a!=b=%d\n",a!=b);
   printf("(a>0)&&(b>0)=%d\n",(a>0)&&(b>0));
   printf("(a>0)||(b>0)=%d",(a>0)||(b>0));

 return 0;
}
