#include<stdio.h>
int main()
{
    int a,b,sum,difference,product,remainder,result,quotient;
    
    printf("Enter the value of a: ");
    scanf("%d",&a);

    printf("Enter the value of b: ");
    scanf("%d",&b);

    if(b==0){
        printf("Error!\nPlease enter a integer value");
    }

    //Arithmetic//

    sum=a+b;
    difference=a-b;
    product=a*b;
    quotient=a/b;
    remainder=a%b;

    printf("Sum is %d\n",sum);
    printf("Difference is %d\n",difference);
    printf("Product is %d\n",product);
    printf("Quotient is %d\n",quotient);
    printf("Remainder is %d\n",remainder);

    //Relational//

    printf("(a>b) is %d\n",a>b);
    printf("(a<b) is %d\n",a<b);
    printf("(a>=b) is %d\n",a>=b);
    printf("(a<=b) is %d\n",a<=b);
    printf("(a==b) is %d\n",a==b);
    printf("(a!=b) is %d\n",a!=b);


   //Logical//

    printf("(a>0)&&(b>0) is %d\n",a>0&&b>0);
    printf("(a>0)||(b>10) is %d\n",a>0||b>10);
    printf("!(a>0) is %d\n",!a>0);

    return 0;
}
