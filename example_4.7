#include<stdio.h>
int main()
{
    float marks;

    printf("Enter the value of marks: ");
    scanf("%f",&marks);

    if(marks<0){
        printf("Invalid marks!\n");
    }
    else if(marks>100){
        printf("Invalid marks!\n");
    }
    else if(marks>=80){
        printf("Grade is A!\n");
    }
    else if(marks>=70){
        printf("Grade is B!\n");
    }
    else if(marks>=60){
        printf("Grade is C!\n");
    }
    else if(marks>=50){
        printf("Grade is D!\n");
    }
    else {
        printf("Grade is F!");
    }

    return 0;
}
